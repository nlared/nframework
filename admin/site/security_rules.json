{
    "rules": [
        {
            "name": "PetalBot",
            "enabled": false,
            "description": "Blocks requests from PetalBot user agent",
            "query": {
                "$and":[ {
                    "agent": {
                        "regex": "PetalBot",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "bingbot",
            "enabled": false,
            "description": "Blocks requests from bingbot user agent",
            "query": {
                "$and":[ {
                    "agent": {
                        "regex": "bingbot",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "GPTBot",
            "enabled": false,
            "description": "Blocks requests from GPTBot user agent",
            "query": {
                "$and":[ {
                    "agent": {
                        "regex": "GPTBot",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "Yandex",
            "enabled": false,
            "description": "Blocks requests from Yandex user agent",
            "query": {
                "$and": [{
                    "agent": {
                        "regex": "Yandex",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "meta-externalagent",
            "enabled": false,
            "description": "Blocks requests from meta-externalagent user agent",
            "query": {
                "$and":[ {
                    "agent": {
                        "regex": "meta-externalagent",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "Googlebot",
            "enabled": false,
            "description": "Blocks requests from Googlebot user agent",
            "query": {
                "$and":[ {
                    "agent": {
                        "regex": "Googlebot",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "AhrefsBot",
            "enabled": false,
            "description": "Blocks requests from AhrefsBot user agent",
            "query": {
                "$and":[ {
                    "agent": {
                        "regex": "AhrefsBot",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "YandexBot",
            "enabled": false,
            "description": "Blocks requests from YandexBot user agent",
            "query": {
                "$and":[ {
                    "agent": {
                        "regex": "YandexBot",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "Bingbot",
            "enabled": false,
            "description": "Blocks requests from Bingbot user agent",
            "query": {
                "$and":[ {
                    "agent": {
                        "regex": "Bingbot",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "Block All Bots",
            "enabled": true,
            "description": "Blocks requests from multiple known bots",
            "query": {
                "$and":[ {
                    "agent": {
                        "regex": "(PetalBot|Googlebot|Bingbot|AhrefsBot|YandexBot|Yandex|meta-externalagent|GPTBot)",
                        "options": "i"
                    }
                } ]
            }
        },
        {
            "name": "Block Common Malicious URIs",
            "enabled": true,
            "description": "Blocks requests to common malicious URIs",
            "query": {
                "$and":[ {
                    "request_uri": {
                        "regex": "(wp-includes/|xmlrpc\\.php|wlwmanifest\\.xml|\\.env|\\.git|config\\.inc\\.php|adminer\\.php|phpmyadmin/|pma/|mysql/|setup\\.php|install\\.php|vendor/|\\.htaccess|\\.bash_history|shellshock|cmd\\.exe|etc/passwd)",
                        "options": "i"
                    }
                } ]
            }
        }
    ]
}