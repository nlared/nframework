{
    "name": "nlared/nframework",
    "description": "Nframework package with artisan generators for ajax templates.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nlared\\Nframework\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nlared\\Nframework\\NframeworkServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
